enum FineStatus {
  PENDING
  PENDING_VERIFICATION
  PAID
}

model Fine {
  id          String     @id @default(uuid())
  amount      Float
  reason      String
  status      FineStatus @default(PENDING)
  receiptUrl  String?
  paymentDate DateTime?

  teamId       String
  matchId      String?
  playerId     String?
  matchEventId String? @unique

  team       Team        @relation("TeamFines", fields: [teamId], references: [id])
  match      Match?      @relation(fields: [matchId], references: [id])
  player     Player?     @relation(fields: [playerId], references: [id])
  matchEvent MatchEvent? @relation(fields: [matchEventId], references: [id], onDelete: SetNull)

  suspension Suspension?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([status])
}

model FineType {
  id            String   @id @default(uuid())
  name          String
  defaultAmount Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

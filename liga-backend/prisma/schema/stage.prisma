enum StageType {
  LEAGUE
  GROUP_STAGE
  KNOCKOUT
}

model Stage {
  id           String    @id @default(uuid())
  tournamentId String
  name         String
  type         StageType
  order        Int
  isTwoLegged  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  matches    Match[]
}
